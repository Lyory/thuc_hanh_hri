<?xml version="1.0"?>
<sdf version="1.8">
  <world name="gesture_arena">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- Create 3 URDF already loads Sensors and Contact systems. Do not duplicate. -->
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-magnetometer-system" name="ignition::gazebo::systems::Magnetometer"/>
    <gravity>0 0 -9.8</gravity>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.75 0.82 0.9 1</background><shadows>false</shadows></scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction><cast_shadows>false</cast_shadows>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Empty 12 x 12 metre arena. Robot at (0,0), dock at (-4,-4). -->
    <model name="walls">
      <static>true</static>
      <link name="north"><pose>0 6 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>12 0.15 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.15 1</size></box></geometry></visual>
      </link>
      <link name="south"><pose>0 -6 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>12 0.15 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12 0.15 1</size></box></geometry></visual>
      </link>
      <link name="east"><pose>6 0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 12 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 12 1</size></box></geometry></visual>
      </link>
      <link name="west"><pose>-6 0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 12 1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 12 1</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
